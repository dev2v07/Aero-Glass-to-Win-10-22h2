  <ItemGroup>
    <ProjectReference Include="..\OpenGlassHost\OpenGlassHost.vcxproj">
      <Project>{6C2D5B3D-4FE4-4E68-8E58-7B5A5D1A3D40}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CopyAeroGlassAssets" AfterTargets="Build">
    <ItemGroup>
      <AeroGlassNavAssets Include="$(ProjectDir)assets\nav\*.svg" />
      <ClassicShellSkinAssets Include="$(ProjectDir)assets\classic-shell\skins\*.*" />
      <ClassicShellLanguageAssets Include="$(ProjectDir)assets\classic-shell\language\*.*" />
      <StartMenuLocalizationAssets Include="$(ProjectDir)..\OpenGlassStartMenu\StartMenu\StartMenuL10N.ini" />
      <StartMenuLocalizationAssets Include="$(ProjectDir)..\OpenGlassStartMenu\StartMenu\StartMenuHelper\StartMenuHelperL10N.ini" />
      <StartButtonAssets Include="$(ProjectDir)assets\Button\start.bmp" />
      <Windows7CursorAssets Include="$(ProjectDir)assets\cursors\windows7\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)assets\nav" />
    <MakeDir Directories="$(OutDir)assets\classic-shell\skins" />
    <MakeDir Directories="$(OutDir)assets\classic-shell\language" />
    <MakeDir Directories="$(OutDir)Languages" />
    <MakeDir Directories="$(OutDir)Button" />
    <MakeDir Directories="$(OutDir)assets\cursors\windows7" />
    <Copy SourceFiles="@(AeroGlassNavAssets)" DestinationFolder="$(OutDir)assets\nav" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ClassicShellSkinAssets)" DestinationFolder="$(OutDir)assets\classic-shell\skins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ClassicShellLanguageAssets)" DestinationFolder="$(OutDir)assets\classic-shell\language" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ClassicShellLanguageAssets)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ClassicShellLanguageAssets)" DestinationFolder="$(OutDir)Languages" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(StartMenuLocalizationAssets)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(StartButtonAssets)" DestinationFolder="$(OutDir)Button" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(Windows7CursorAssets)" DestinationFolder="$(OutDir)assets\cursors\windows7" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="BuildOpenGlassStartMenuIfMissing"
          BeforeTargets="CopyOpenGlassStartMenuArtifacts"
          Condition="!Exists('$(ProjectDir)..\build\bin\$(Configuration)64\OpenGlassStartMenu.exe')">
    <Message Text="OpenGlassStartMenu.exe is missing; building the Start Menu runtime before copying GUI artifacts." Importance="High" />
    <MSBuild Projects="$(ProjectDir)..\OpenGlassStartMenu\StartMenu\StartMenu.vcxproj"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=$(Platform);PlatformToolset=$(PlatformToolset);WindowsTargetPlatformVersion=$(WindowsTargetPlatformVersion);VcpkgInstalledDir=$(VcpkgInstalledDir);VcpkgTriplet=$(VcpkgTriplet)" />
  </Target>
  <Target Name="CopyOpenGlassStartMenuArtifacts" AfterTargets="CopyAeroGlassAssets" Condition="Exists('$(ProjectDir)..\build\bin\$(Configuration)64')">
    <ItemGroup>
      <OpenGlassStartMenuBinaries Include="$(ProjectDir)..\build\bin\$(Configuration)64\*.exe" />
      <OpenGlassStartMenuBinaries Include="$(ProjectDir)..\build\bin\$(Configuration)64\*.dll" />
      <OpenGlassStartMenuSkins Include="$(ProjectDir)..\build\bin\Skins\*.skin*" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)Skins" />
    <Copy SourceFiles="@(OpenGlassStartMenuBinaries)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(OpenGlassStartMenuBinaries.Identity)')" />
    <Copy SourceFiles="@(OpenGlassStartMenuSkins)" DestinationFolder="$(OutDir)Skins" SkipUnchangedFiles="true" />
  </Target>
  <ImportGroup Label="ExtensionTargets">
    <Import Project="..\Common\NuGet.targets" Condition="Exists('..\Common\NuGet.targets')" />
  </ImportGroup>
</Project>
