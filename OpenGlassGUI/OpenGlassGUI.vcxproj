  </ImportGroup>
  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>comctl32.lib;rpcrt4.lib;winmm.lib;advapi32.lib;wsock32.lib;uxtheme.lib;powrprof.lib;wxmsw33u_stc.lib;wxscintilla.lib;wxlexilla.lib;wxmsw33u_aui.lib;wxmsw33u_adv.lib;wxmsw33u_core.lib;wxmsw33u_html.lib;wxmsw33u_propgrid.lib;wxmsw33u_richtext.lib;wxmsw33u_xrc.lib;wxbase33u_net.lib;wxbase33u_xml.lib;wxbase33u.lib;nanosvg.lib;nanosvgrast.lib;libpng16.lib;zs.lib;%(AdditionalDependencies)</AdditionalDependencies>
